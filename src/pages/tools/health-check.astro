---
import BaseLayout from '@/layouts/BaseLayout.astro';

const PAID_CHECK_PREVIEWS = [
  { name: 'SameSite Cookie Policy',           category: 'cookies' },
  { name: 'Secure Cookie Prefixes (__Host-)', category: 'cookies' },
  { name: 'Content-Security-Policy Strength', category: 'headers' },
  { name: 'Referrer-Policy',                  category: 'headers' },
  { name: 'Permissions-Policy',               category: 'headers' },
  { name: 'Cross-Origin Isolation (COOP)',    category: 'headers' },
  { name: 'OIDC Discovery Endpoint',          category: 'oauth'   },
  { name: 'PKCE S256 Enforcement',            category: 'oauth'   },
  { name: 'Deprecated OAuth Grant Types',     category: 'oauth'   },
  { name: 'Passkey / WebAuthn Support',       category: 'oauth'   },
  { name: 'Phishing-Resistant Authentication',category: 'oauth'   },
  { name: 'DKIM Record',                      category: 'email'   },
  { name: 'DMARC Policy Level',               category: 'email'   },
  { name: 'SPF Enforcement Level',            category: 'email'   },
  { name: 'Auth Subdomain Surface',           category: 'exposure'},
  { name: 'Security.txt Disclosure',          category: 'exposure'},
  { name: 'Source Map Exposure',              category: 'exposure'},
];
---

<BaseLayout
  title="External Security Assessment | AuthLayer"
  description="See your website, APIs and authentication systems the way an attacker sees them. Discover exposed assets, authentication weaknesses, API risks and security misconfigurations before attackers do."
>
  <section class="esa-page">
    <div class="container">

      <header class="page-header">
        <span class="tag">Tools</span>
        <h1>External Security Assessment</h1>
        <p class="subtitle">
          See your website, APIs and authentication systems the way an attacker sees them.
          All checks are passive and non-destructive — no writing to the target.
        </p>
      </header>

      <!-- ── Assessment form ─────────────────────────────────── -->
      <div class="assessment-form" id="assessment-form">

        <!-- Section 1: Target -->
        <div class="form-section">
          <div class="section-label">Target</div>

          <div class="field-row field-row--two">
            <div class="field">
              <label for="company-input">Company / Project name <span class="optional">optional</span></label>
              <input
                id="company-input"
                type="text"
                placeholder="Acme Corp"
                autocomplete="organization"
                spellcheck="false"
              />
            </div>
            <div class="field">
              <label for="domain-input">Primary website <span class="required-mark">*</span></label>
              <input
                id="domain-input"
                type="text"
                placeholder="https://example.com"
                autocomplete="off"
                spellcheck="false"
                autocorrect="off"
                autocapitalize="off"
              />
            </div>
          </div>

          <div class="field-row field-row--two">
            <div class="field">
              <label for="auth-url-input">Login / Auth URL <span class="optional">optional</span></label>
              <input
                id="auth-url-input"
                type="text"
                placeholder="https://login.example.com/signin"
                autocomplete="off"
                spellcheck="false"
                autocorrect="off"
                autocapitalize="off"
              />
            </div>
            <div class="field">
              <label for="api-url-input">API URL <span class="optional">optional</span></label>
              <input
                id="api-url-input"
                type="text"
                placeholder="https://api.example.com"
                autocomplete="off"
                spellcheck="false"
                autocorrect="off"
                autocapitalize="off"
              />
            </div>
          </div>

          <div class="field">
            <label for="additional-assets">Additional assets <span class="optional">optional — one URL per line</span></label>
            <textarea
              id="additional-assets"
              rows="3"
              placeholder="https://api.example.com&#10;https://docs.example.com"
              spellcheck="false"
              autocorrect="off"
              autocapitalize="off"
            ></textarea>
          </div>
        </div>

        <!-- Section 2: Scope + authorization -->
        <div class="form-section">
          <div class="section-label">Scope &amp; Authorization</div>

          <div class="field">
            <label for="scope-input">Scope <span class="optional">optional — restrict scan to these domains</span></label>
            <textarea
              id="scope-input"
              rows="2"
              placeholder="example.com&#10;*.example.com"
              spellcheck="false"
              autocorrect="off"
              autocapitalize="off"
            ></textarea>
          </div>

          <label class="auth-checkbox-row" id="auth-label">
            <div class="checkbox-wrapper">
              <input type="checkbox" id="auth-checkbox" />
              <span class="custom-checkbox"></span>
            </div>
            <div class="auth-checkbox-text">
              I confirm that I own or am authorised to test these systems.
              <span class="legal-note">Only scan systems you own or have explicit written permission to test.</span>
            </div>
          </label>

          <p id="auth-error" class="field-error" hidden>You must confirm authorization before running an assessment.</p>
          <p id="domain-error" class="field-error" hidden>Enter a valid website URL or domain (e.g. https://example.com or example.com)</p>

          <div class="btn-row">
            <button id="btn-free" class="btn btn-primary" type="button" disabled>
              Run Free Assessment
            </button>
            <button id="btn-paid" class="btn btn-pro" type="button" disabled>
              Deeper Assessment
            </button>
          </div>
        </div>

      </div>

      <!-- ── Results area ────────────────────────────────────── -->
      <div id="results-area" class="results-area">

        <!-- Loading / progress -->
        <div id="state-loading" class="state-loading" hidden>
          <div class="progress-header">
            <div class="spinner"></div>
            <div>
              <div class="loading-title">Assessing <strong id="loading-domain"></strong></div>
              <div class="loading-sub">Passive checks running in parallel…</div>
            </div>
          </div>
          <div class="phases" id="phases-list">
            <div class="phase phase--active" data-phase="dns">
              <span class="phase-icon">○</span>
              <span class="phase-name">DNS &amp; Certificate</span>
            </div>
            <div class="phase" data-phase="web">
              <span class="phase-icon">○</span>
              <span class="phase-name">HTTP Security</span>
            </div>
            <div class="phase" data-phase="email">
              <span class="phase-icon">○</span>
              <span class="phase-name">Email Security</span>
            </div>
            <div class="phase" data-phase="oauth">
              <span class="phase-icon">○</span>
              <span class="phase-name">OAuth / OIDC</span>
            </div>
            <div class="phase" data-phase="auth">
              <span class="phase-icon">○</span>
              <span class="phase-name">Authentication</span>
            </div>
            <div class="phase" data-phase="exposure">
              <span class="phase-icon">○</span>
              <span class="phase-name">Exposure Analysis</span>
            </div>
          </div>
        </div>

        <!-- Results -->
        <div id="state-results" hidden>

          <!-- Summary bar -->
          <div class="summary-bar" id="summary-bar">
            <div class="summary-title" id="summary-title">External Security Assessment</div>
            <div class="summary-stats" id="summary-stats"></div>
            <div class="sev-breakdown" id="sev-breakdown"></div>
            <div class="score-indicator" id="score-indicator"></div>
            <div class="summary-chips" id="summary-chips"></div>
          </div>

          <!-- Top findings -->
          <div id="top-findings-section" class="top-findings-section" hidden>
            <div class="section-head">
              <span class="section-head-icon">▲</span>
              Immediate attention
            </div>
            <div id="top-findings-list" class="top-findings-list"></div>
          </div>

          <!-- Full findings list -->
          <div id="results-list" class="results-list"></div>

          <!-- Paid teaser -->
          <div id="paid-teaser" class="paid-teaser" hidden>
            <div class="teaser-header">
              <span class="lock-icon">⊘</span>
              <div>
                <div class="teaser-title">Run a deeper external security assessment</div>
                <div class="teaser-sub">Cookie policy, CSP strength, OIDC/PKCE, DKIM, DMARC enforcement, source map exposure, subdomain surface, and more — a complete view of your attack surface</div>
              </div>
            </div>
            <ul class="teaser-list" id="teaser-list"></ul>
            <button id="btn-upgrade" class="btn btn-pro teaser-btn" type="button">
              Run Deeper Assessment
            </button>
          </div>

        </div>

        <!-- Error -->
        <div id="state-error" class="state-error" hidden>
          <span class="error-icon">✗</span>
          <span id="error-text"></span>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ PAID_CHECK_PREVIEWS }}>
  // ─── DOM refs ───────────────────────────────────────────────────────────────
  const domainInput      = document.getElementById('domain-input');
  const authUrlInput     = document.getElementById('auth-url-input');
  const apiUrlInput      = document.getElementById('api-url-input');
  const additionalAssets = document.getElementById('additional-assets');
  const scopeInput       = document.getElementById('scope-input');
  const authCheckbox     = document.getElementById('auth-checkbox');

  const btnFree    = document.getElementById('btn-free');
  const btnPaid    = document.getElementById('btn-paid');
  const btnUpgrade = document.getElementById('btn-upgrade');

  const authError   = document.getElementById('auth-error');
  const domainError = document.getElementById('domain-error');

  const stateLoading = document.getElementById('state-loading');
  const stateResults = document.getElementById('state-results');
  const stateError   = document.getElementById('state-error');

  const loadingDomain    = document.getElementById('loading-domain');
  const phasesList       = document.getElementById('phases-list');
  const summaryBar       = document.getElementById('summary-bar');
  const summaryTitle     = document.getElementById('summary-title');
  const summaryStats     = document.getElementById('summary-stats');
  const sevBreakdown     = document.getElementById('sev-breakdown');
  const summaryChips     = document.getElementById('summary-chips');
  const topFindingsSection = document.getElementById('top-findings-section');
  const topFindingsList  = document.getElementById('top-findings-list');
  const resultsList      = document.getElementById('results-list');
  const paidTeaser       = document.getElementById('paid-teaser');
  const teaserList       = document.getElementById('teaser-list');
  const errorText        = document.getElementById('error-text');

  // ─── Constants ──────────────────────────────────────────────────────────────
  const CATEGORY_LABELS = {
    transport:      'Transport Security',
    cookies:        'Cookie Security',
    headers:        'HTTP Security Headers',
    email:          'Email Authentication',
    oauth:          'OAuth / OIDC Posture',
    exposure:       'Exposure & Disclosure',
    api:            'API Security',
    authentication: 'Authentication',
  };

  const STATUS_ICON  = { pass: '✓', fail: '✗', warn: '⚠', info: '●', error: '?' };

  const SEV_ICON  = { critical: '◆', high: '▲', medium: '■', low: '▸', informational: '·' };
  const SEV_LABEL = { critical: 'Critical', high: 'High', medium: 'Medium', low: 'Low', informational: 'Info' };

  const CONF_LABEL = {
    confirmed:     'Confirmed',
    high:          'High confidence',
    medium:        'Medium confidence',
    low:           'Low confidence',
    informational: 'Informational',
  };

  const PHASE_ORDER = ['dns', 'web', 'email', 'oauth', 'auth', 'exposure'];
  const PHASE_DELAYS = [800, 1600, 2400, 3200, 4000, 4800];

  // ─── Helpers ────────────────────────────────────────────────────────────────
  function escHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function isValidDomain(d) {
    if (!d) return false;
    const lower = d.toLowerCase();
    if (/(^localhost$|^127\.|^10\.|^192\.168\.|^172\.(1[6-9]|2\d|3[01])\.|^169\.254\.|^0\.|\.local$)/.test(lower)) return false;
    return /^[a-z0-9]([a-z0-9\-.]{0,251}[a-z0-9])?$/.test(lower);
  }

  function parseInput(raw) {
    const trimmed = raw.trim();
    if (/^https?:\/\//i.test(trimmed)) {
      try {
        const secure = trimmed.replace(/^http:\/\//i, 'https://');
        const u = new URL(secure);
        return { domain: u.hostname.toLowerCase(), authUrl: u.href };
      } catch { return { domain: null, authUrl: null }; }
    }
    const d = trimmed.toLowerCase().replace(/^https?:\/\//, '').replace(/[/?#].*$/, '').trim();
    return { domain: d || null, authUrl: null };
  }

  function setState(name) {
    stateLoading.hidden = name !== 'loading';
    stateResults.hidden = name !== 'results';
    stateError.hidden   = name !== 'error';
  }

  function gradeColor(grade) {
    return { A: '#34d399', B: '#4ade80', C: '#fbbf24', D: '#f97316', F: '#f87171' }[grade] ?? '#64748b';
  }

  // ─── Phase animation ────────────────────────────────────────────────────────
  let phaseTimers = [];

  function startPhaseAnimation() {
    stopPhaseAnimation();
    const phases = phasesList.querySelectorAll('.phase');
    phases.forEach(p => {
      p.classList.remove('phase--active', 'phase--done');
      p.querySelector('.phase-icon').textContent = '○';
    });
    PHASE_ORDER.forEach((name, i) => {
      const t = setTimeout(() => {
        // Mark previous done
        if (i > 0) {
          const prev = phasesList.querySelector(`[data-phase="${PHASE_ORDER[i - 1]}"]`);
          if (prev) {
            prev.classList.remove('phase--active');
            prev.classList.add('phase--done');
            prev.querySelector('.phase-icon').textContent = '✓';
          }
        }
        const cur = phasesList.querySelector(`[data-phase="${name}"]`);
        if (cur) {
          cur.classList.add('phase--active');
          cur.querySelector('.phase-icon').textContent = '●';
        }
      }, PHASE_DELAYS[i]);
      phaseTimers.push(t);
    });
  }

  function stopPhaseAnimation() {
    phaseTimers.forEach(clearTimeout);
    phaseTimers = [];
  }

  function completePhaseAnimation() {
    stopPhaseAnimation();
    const phases = phasesList.querySelectorAll('.phase');
    phases.forEach(p => {
      p.classList.remove('phase--active');
      p.classList.add('phase--done');
      p.querySelector('.phase-icon').textContent = '✓';
    });
  }

  // ─── Authorization toggle ───────────────────────────────────────────────────
  authCheckbox.addEventListener('change', () => {
    const checked = authCheckbox.checked;
    btnFree.disabled = !checked;
    btnPaid.disabled = !checked;
    authError.hidden = true;
  });

  // ─── Build results ──────────────────────────────────────────────────────────
  function buildResults(data) {
    const { domain, report, findings, topFindings, assetsDiscovered, endpointsTested, testsRun, score, grade } = data;
    const company = document.getElementById('company-input').value.trim();

    // Summary bar
    const color = gradeColor(grade);
    summaryTitle.textContent = company ? `${company} — External Security Assessment` : 'External Security Assessment';

    const sevCounts = { critical: 0, high: 0, medium: 0, low: 0, informational: 0 };
    for (const f of findings) {
      if (f.status === 'fail' || f.status === 'warn') {
        const k = f.severity === 'informational' ? 'informational' : f.severity;
        if (k in sevCounts) sevCounts[k]++;
      }
    }

    summaryStats.innerHTML = `
      <span class="stat"><span class="stat-value">${assetsDiscovered}</span> asset${assetsDiscovered !== 1 ? 's' : ''}</span>
      <span class="stat-sep">·</span>
      <span class="stat"><span class="stat-value">${endpointsTested}</span> endpoints tested</span>
      <span class="stat-sep">·</span>
      <span class="stat"><span class="stat-value">${testsRun}</span> security tests</span>`;

    const sevRows = [
      { key: 'critical',     label: 'Critical', color: '#f87171' },
      { key: 'high',         label: 'High',     color: '#fb923c' },
      { key: 'medium',       label: 'Medium',   color: '#facc15' },
      { key: 'low',          label: 'Low',       color: '#60a5fa' },
      { key: 'informational',label: 'Info',     color: '#94a3b8' },
    ];
    const scoreEl = document.getElementById('score-indicator');
    if (scoreEl) {
      scoreEl.innerHTML = `Security posture score: <strong style="color:${color}">${grade} (${score}/100)</strong>`;
    }

    sevBreakdown.innerHTML = sevRows.map(r =>
      `<div class="sev-cell">
        <span class="sev-count" style="color:${r.color}">${sevCounts[r.key]}</span>
        <span class="sev-label-sm">${r.label}</span>
      </div>`
    ).join('');

    const confirmedCount = findings.filter(f => f.classification === 'confirmed_vulnerability').length;
    const potentialCount = findings.filter(f => f.classification === 'potential_vulnerability').length;
    const passCount      = findings.filter(f => f.classification === 'passed').length;
    const notChecked     = findings.filter(f => f.classification === 'not_checked').length;
    summaryChips.innerHTML = [
      confirmedCount ? `<span class="chip chip-fail">${confirmedCount} confirmed vulnerability${confirmedCount > 1 ? 's' : ''}</span>` : '',
      potentialCount ? `<span class="chip chip-warn">${potentialCount} potential vulnerability${potentialCount > 1 ? 's' : ''}</span>` : '',
      !confirmedCount && !potentialCount ? `<span class="chip chip-pass">No confirmed vulnerabilities</span>` : '',
      `<span class="chip chip-pass">${passCount} passed</span>`,
      notChecked ? `<span class="chip chip-err">${notChecked} not checked</span>` : '',
      `<span class="chip ${report === 'paid' ? 'chip-paid' : 'chip-free'}">${report === 'paid' ? 'Deeper Assessment' : 'Surface Assessment'}</span>`,
    ].filter(Boolean).join('');

    // Top findings
    if (topFindings?.length > 0) {
      topFindingsList.innerHTML = '';
      for (const f of topFindings) topFindingsList.appendChild(buildCard(f, true));
      topFindingsSection.hidden = false;
    } else {
      topFindingsSection.hidden = true;
    }

    // Classification-grouped full list (spec §13)
    const RISK_GROUPS = [
      { key: 'confirmed',   label: 'Confirmed Vulnerabilities',   icon: '◆', color: '#ef4444' },
      { key: 'potential',   label: 'Potential Vulnerabilities',   icon: '▲', color: '#f97316' },
      { key: 'observation', label: 'Security Observations',       icon: '●', color: '#eab308' },
      { key: 'hardening',   label: 'Hardening Recommendations',   icon: '◉', color: '#3b82f6' },
      { key: 'pass',        label: 'Passed',                      icon: '✓', color: '#22c55e' },
      { key: 'na',          label: 'Not Checked',                 icon: '○', color: '#64748b' },
    ];

    function getGroup(c) {
      switch (c.classification) {
        case 'confirmed_vulnerability':  return 'confirmed';
        case 'potential_vulnerability':  return 'potential';
        case 'security_observation':     return 'observation';
        case 'hardening_recommendation': return 'hardening';
        case 'passed':                   return 'pass';
        default: return c.status === 'pass' ? 'pass' : 'na';
      }
    }

    const grouped = {};
    for (const g of RISK_GROUPS) grouped[g.key] = [];
    for (const c of findings) grouped[getGroup(c)].push(c);

    resultsList.innerHTML = '';
    for (const group of RISK_GROUPS) {
      const items = grouped[group.key];
      if (!items.length) continue;
      const section = document.createElement('div');
      section.className = `risk-section risk-section-${group.key}`;
      const header = document.createElement('div');
      header.className = `risk-header risk-${group.key}`;
      header.innerHTML = `
        <span class="risk-hicon">${group.icon}</span>
        <span class="risk-hlabel">${group.label}</span>
        <span class="risk-hcount">${items.length}</span>`;
      section.appendChild(header);
      const cardsDiv = document.createElement('div');
      cardsDiv.className = `risk-cards risk-cards-${group.key}`;
      for (const check of items) cardsDiv.appendChild(buildCard(check, false));
      section.appendChild(cardsDiv);
      resultsList.appendChild(section);
    }

    // Paid teaser
    if (report === 'free') {
      teaserList.innerHTML = PAID_CHECK_PREVIEWS.map(c =>
        `<li class="teaser-item">
          <span class="lock-pill">🔒</span>
          <span class="teaser-check-name">${escHtml(c.name)}</span>
          <span class="teaser-cat">${escHtml(CATEGORY_LABELS[c.category] ?? c.category)}</span>
        </li>`
      ).join('');
      paidTeaser.hidden = false;
    } else {
      paidTeaser.hidden = true;
    }
  }

  function buildCard(f, compact) {
    const showSev  = f.status === 'fail' || f.status === 'warn';
    const isError  = f.status === 'error';
    const hasDetail = f.detail || f.remediation || f.business_impact || f.evidence || isError;

    const inlineRefsHtml = (showSev && f.references?.length) ? `
      <div class="inline-refs">${
        f.references.slice(0, 3).map(r =>
          `<a href="${escHtml(r.url)}" target="_blank" rel="noopener noreferrer" class="inline-ref">${escHtml(r.label)}</a>`
        ).join('')
      }</div>` : '';

    const confBadgeHtml = showSev && f.confidence && f.confidence !== 'confirmed'
      ? `<span class="conf-badge">${escHtml(CONF_LABEL[f.confidence] ?? f.confidence)}</span>`
      : '';

    const allRefsHtml = f.references?.length ? `
      <div class="ref-row">
        <span class="ref-label">Standards &amp; References</span>
        <div class="ref-links">${
          f.references.map(r =>
            `<a href="${escHtml(r.url)}" target="_blank" rel="noopener noreferrer" class="ref-link">${escHtml(r.label)}</a>`
          ).join('')
        }</div>
      </div>` : '';

    const mappingsHtml = (f.owasp_mapping || f.cwe) ? `
      <div class="mappings-row">
        ${f.owasp_mapping ? `<span class="mapping-tag owasp-tag">${escHtml(f.owasp_mapping)}</span>` : ''}
        ${f.cwe ? `<span class="mapping-tag cwe-tag">${escHtml(f.cwe)}</span>` : ''}
      </div>` : '';

    const errorBannerHtml = isError ? `
      <div class="error-banner">
        <span class="error-banner-icon">?</span>
        <div>
          <div class="error-banner-title">Could not complete this check</div>
          <div class="error-banner-body">${escHtml(f.errorReason ?? 'The domain may be unreachable, the request timed out, or the endpoint does not exist. This is not a security finding.')}</div>
        </div>
      </div>` : '';

    const detailHtml = hasDetail ? `
      <div class="result-detail" hidden>
        ${isError ? errorBannerHtml : ''}
        ${f.detail ? `<p class="detail-text">${escHtml(f.detail)}</p>` : ''}
        ${f.business_impact ? `<div class="impact-block"><span class="impact-label">Business impact</span>${escHtml(f.business_impact)}</div>` : ''}
        ${f.remediation ? `<div class="remediation"><span class="remed-label">How to fix</span>${escHtml(f.remediation)}</div>` : ''}
        ${mappingsHtml}
        ${allRefsHtml}
      </div>` : '';

    const card = document.createElement('div');
    card.className = `result-card status-${f.status}${compact ? ' result-card--compact' : ''}`;
    card.innerHTML = `
      <div class="result-row${hasDetail ? ' expandable' : ''}"${hasDetail ? ' role="button" tabindex="0"' : ''}>
        <span class="status-dot status-${f.status}">${STATUS_ICON[f.status] ?? '?'}</span>
        <div class="result-body">
          <div class="result-header-row">
            <span class="check-name">${escHtml(f.name)}</span>
            ${showSev ? `<span class="sev-badge sev-${f.severity}"><span class="sev-icon">${SEV_ICON[f.severity] ?? ''}</span>${SEV_LABEL[f.severity] ?? f.severity}</span>` : ''}
            ${isError ? '<span class="sev-badge sev-na">N/A</span>' : ''}
            ${confBadgeHtml}
            ${f.classification && f.classification !== 'passed' && f.classification !== 'not_checked' ? `<span class="class-badge class-${f.classification.split('_')[0]}">${
              { confirmed_vulnerability: 'Confirmed', potential_vulnerability: 'Potential', security_observation: 'Observation', hardening_recommendation: 'Recommendation' }[f.classification] ?? ''
            }</span>` : ''}
          </div>
          <span class="check-finding">${escHtml(f.finding)}</span>
          ${inlineRefsHtml}
        </div>
        ${hasDetail ? '<span class="expand-arrow" aria-hidden="true">▸</span>' : ''}
      </div>
      ${detailHtml}`;

    if (hasDetail) {
      const row    = card.querySelector('.result-row');
      const detail = card.querySelector('.result-detail');
      const arrow  = card.querySelector('.expand-arrow');
      const toggle = () => {
        const open = !detail.hidden;
        detail.hidden = open;
        if (arrow) arrow.textContent = open ? '▸' : '▾';
        card.classList.toggle('expanded', !open);
      };
      row.addEventListener('click', toggle);
      row.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
    }
    return card;
  }

  // ─── Run scan ───────────────────────────────────────────────────────────────
  async function runReport(reportType) {
    authError.hidden = true;
    domainError.hidden = true;

    if (!authCheckbox.checked) {
      authError.hidden = false;
      authCheckbox.closest('.auth-checkbox-row').scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    const { domain, authUrl: parsedAuthUrl } = parseInput(domainInput.value);
    if (!isValidDomain(domain)) {
      domainError.hidden = false;
      domainInput.focus();
      return;
    }

    setState('loading');
    loadingDomain.textContent = document.getElementById('company-input').value.trim()
      ? `${document.getElementById('company-input').value.trim()} (${domain})`
      : domain;
    startPhaseAnimation();

    btnFree.disabled = true;
    btnPaid.disabled = true;

    try {
      const authUrlVal = document.getElementById('auth-url-input').value.trim() || parsedAuthUrl;
      const extraAssets = document.getElementById('additional-assets').value.trim();
      const scopeVal    = document.getElementById('scope-input').value.trim();

      const apiUrlVal = apiUrlInput?.value?.trim() ?? '';
      let apiUrl = `/api/health-check?domain=${encodeURIComponent(domain)}&report=${reportType}`;
      if (authUrlVal)    apiUrl += `&authUrl=${encodeURIComponent(authUrlVal)}`;
      if (apiUrlVal)     apiUrl += `&apiUrl=${encodeURIComponent(apiUrlVal)}`;
      if (extraAssets)   apiUrl += `&additionalAssets=${encodeURIComponent(extraAssets)}`;
      if (scopeVal)      apiUrl += `&scope=${encodeURIComponent(scopeVal)}`;

      const res  = await fetch(apiUrl);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? 'Assessment failed');

      completePhaseAnimation();
      buildResults(data);
      setState('results');
      document.getElementById('results-area').scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (e) {
      stopPhaseAnimation();
      errorText.textContent = e.message ?? 'An unexpected error occurred';
      setState('error');
    } finally {
      btnFree.disabled  = !authCheckbox.checked;
      btnPaid.disabled  = !authCheckbox.checked;
    }
  }

  btnFree.addEventListener('click',    () => runReport('free'));
  btnPaid.addEventListener('click',    () => runReport('paid'));
  btnUpgrade?.addEventListener('click',() => runReport('paid'));

  domainInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' && authCheckbox.checked) runReport('free');
  });
</script>

