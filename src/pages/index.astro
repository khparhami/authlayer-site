---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const tools = [
  {
    name: 'External Security Assessment',
    href: '/tools/health-check',
    category: 'Security Audit',
    desc: 'DNS, TLS, HTTP headers, email (SPF/DKIM/DMARC), OAuth/OIDC posture, and exposure analysis — passive external scan.',
  },
  {
    name: 'Domain Threat Detection',
    href: '/tools/domain-monitoring',
    category: 'Threat Detection',
    desc: 'Lookalike domain variants, certificate transparency log discovery, DNS resolution, phishing pattern detection.',
  },
  {
    name: 'JWT Decoder',
    href: '/tools/jwt-decoder',
    category: 'JWT',
    desc: 'Decode header and payload, inspect standard and custom claims, view signature algorithm.',
  },
  {
    name: 'JWT Generator',
    href: '/tools/jwt-generator',
    category: 'JWT',
    desc: 'Sign tokens with RS256, ES256, or HS256. Configure claims, expiry, audience, and custom fields.',
  },
  {
    name: 'JWT Claim Validator',
    href: '/tools/jwt-validator',
    category: 'JWT',
    desc: 'Validate exp, iat, nbf, aud, iss. Check custom claim constraints and required fields.',
  },
  {
    name: 'TOTP Generator',
    href: '/tools/totp',
    category: 'MFA',
    desc: 'Time-based one-time passwords per RFC 6238. Useful for testing TOTP setup and recovery flows.',
  },
  {
    name: 'Base64 Encoder / Decoder',
    href: '/tools/base64',
    category: 'Encoding',
    desc: 'Standard and URL-safe Base64 encoding and decoding with binary and UTF-8 input support.',
  },
  {
    name: 'OAuth 2.0 Flow Builder',
    href: '/tools/oauth-flow',
    category: 'OAuth',
    desc: 'Construct and inspect authorization code, implicit, and PKCE flows step by step.',
  },
];
---

<BaseLayout
  title="AuthLayer — Security Tools & Auth Guides"
  description="Security tools and technical writing for developers working with authentication and identity. Free external security assessment, JWT tools, OAuth flow builder, and more."
>
  <div class="home">

    <header class="site-header">
      <div class="container">
        <h1 class="site-name">AuthLayer</h1>
        <p class="site-desc">
          Security tools and technical writing for developers working with authentication and identity.
        </p>
      </div>
    </header>

    <section class="tools-section">
      <div class="container">
        <div class="section-head">
          <span class="section-label">Tools</span>
          <a href="/tools" class="view-all">All tools →</a>
        </div>
        <div class="tools-list">
          {tools.map(t => (
            <a href={t.href} class="tool-row">
              <div class="tool-main">
                <span class="tool-name">{t.name}</span>
                <span class="tool-cat">{t.category}</span>
              </div>
              <p class="tool-desc">{t.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="articles-section">
      <div class="container">
        <div class="section-head">
          <span class="section-label">Articles</span>
          <a href="/blog" class="view-all">All articles →</a>
        </div>
        <div class="posts-grid">
          {posts.map(post => <BlogCard post={post} />)}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
.home {
  padding-bottom: 6rem;
}

/* ── Site header ──────────────────────────────────────── */
.site-header {
  padding: 3.5rem 0 2.5rem;
  border-bottom: 1px solid var(--border);
  margin-bottom: 3rem;
}

.site-name {
  font-size: 1.4rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--text);
  margin-bottom: 0.5rem;
}

.site-desc {
  color: var(--text-dim);
  font-size: 0.92rem;
  max-width: 520px;
  line-height: 1.65;
  margin: 0;
}

/* ── Section chrome ───────────────────────────────────── */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 1.25rem;
}

.section-label {
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.view-all {
  font-size: 0.8rem;
  color: var(--accent);
  text-decoration: none;
}
.view-all:hover { text-decoration: underline; }

/* ── Tools section ────────────────────────────────────── */
.tools-section {
  margin-bottom: 4rem;
}

.tools-list {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
}

.tool-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.3rem;
  padding: 1rem 1.25rem;
  text-decoration: none;
  border-bottom: 1px solid var(--border);
  transition: background 0.15s;
}
.tool-row:last-child { border-bottom: none; }
.tool-row:hover { background: var(--bg-hover, rgba(255,255,255,0.03)); }

@media (min-width: 600px) {
  .tool-row {
    grid-template-columns: 280px 1fr;
    gap: 1.5rem;
    align-items: center;
  }
}

.tool-main {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
}

.tool-name {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
}

.tool-cat {
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--accent);
  background: rgba(56, 189, 248, 0.08);
  border: 1px solid rgba(56, 189, 248, 0.18);
  padding: 0.15em 0.5em;
  border-radius: 3px;
  white-space: nowrap;
  flex-shrink: 0;
}

.tool-desc {
  font-size: 0.8rem;
  color: var(--text-muted);
  margin: 0;
  line-height: 1.55;
}

/* ── Articles section ─────────────────────────────────── */
.articles-section {
  margin-bottom: 2rem;
}

.posts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1rem;
}
</style>
